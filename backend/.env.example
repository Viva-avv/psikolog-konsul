NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Set to 1 when running behind a reverse proxy (for correct client IP in rate limiting)
TRUST_PROXY=0

DATABASE_URL=postgresql://psikolog:psikolog_dev_password@localhost:5432/psikolog?schema=public

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Field-level encryption keys, format "version:base64key" (32 bytes), comma-separated for rotation
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
DATA_ENCRYPTION_KEY_CURRENT=1

# Salt for hashing IP addresses in audit log
IP_HASH_SALT=change_me_random_salt

# Version of the privacy policy / terms users consent to
POLICY_VERSION=2026-11-01

# Private storage for STR/SIPP documents (never served statically)
UPLOAD_DIR=uploads

# Seed admin account
SEED_ADMIN_EMAIL=admin@psikolog.local
SEED_ADMIN_PASSWORD=ChangeMe!Admin123

# AI (server-side only, never expose to the frontend)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Video call (https://dashboard.daily.co/developers)
DAILY_API_KEY=

# Midtrans sandbox (https://dashboard.sandbox.midtrans.com > Settings > Access Keys)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
